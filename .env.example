OPENROUTER_API_KEY=your_openrouter_api_key
SERPER_API_KEY=your_serper_api_key

# Optional configuration
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
RAG_EMBEDDING_MODEL=openai/text-embedding-3-small
RAG_LLM_MODEL=openai/gpt-4.1-mini
RAG_PDF_PATH=documents/Fractal-Financial-Results-FY-2025-26.pdf
RAG_DATA_DIR=data
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_MAX_TOKENS_REWRITE=100
RAG_MAX_TOKENS_RESPONSE=1000
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Local Windows/OpenSSL workaround only. Do not enable in production.
RAG_INSECURE_SKIP_TLS_VERIFY=false
